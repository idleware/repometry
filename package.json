{
  "name": "repometry-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Repometry and its plugins",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/repometry"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "coverage": "npm run build:test --workspaces && c8 --all --src packages/repometry/target/main/ts --src packages/repometry/target/verification/main/ts --include 'packages/*/src/main/ts/**' --exclude-after-remap --reporter lcov --reporter text-summary --reports-dir target/coverage npm exec --workspaces -- node --test 'target/verification/test/ts/*.test.js'"
  },
  "devDependencies": {
    "c8": "12.0.0"
  },
  "release": {
    "tagFormat": "pure",
    "meta": "asset",
    "populate": {
      "schemas": {
        "text": {
          "type": "string",
          "pattern": "(?![\\s\\S]*(?:gh[opsur]_|github_pat_|eyJ))[\\s\\S]*"
        },
        "secret": {
          "type": "secret"
        },
        "sha": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "repo": {
          "const": "idleware/repometry"
        },
        "repoUrl": {
          "type": "url",
          "protocol": "https:",
          "hostname": "github.com",
          "pathname": {
            "pattern": "/idleware/repometry(\\.git)?"
          },
          "username": {},
          "password": {}
        },
        "ghApi": {
          "const": "https://api.github.com"
        },
        "registry": {
          "enum": [
            "",
            "https://registry.npmjs.org",
            "https://registry.npmjs.org/"
          ]
        },
        "oidc": {
          "const": "true"
        },
        "asset": {
          "const": "asset"
        }
      },
      "channels": {
        "*": {
          "*": {
            "schema": "text"
          },
          "repoName": {
            "schema": "repo"
          },
          "repoAuthedUrl": {
            "schema": "repoUrl"
          },
          "ghBasicAuth": {
            "schema": "*"
          }
        },
        "git-tag": {
          "sha": {
            "schema": "sha"
          }
        },
        "npm": {
          "registry": {
            "schema": "registry"
          },
          "oidc": {
            "schema": "oidc"
          }
        },
        "gh-release": {
          "token": {
            "schema": "secret"
          },
          "apiUrl": {
            "schema": "ghApi"
          },
          "assets": {
            "schema": "*"
          }
        },
        "meta": {
          "type": {
            "schema": "asset"
          },
          "data": {
            "schema": "*"
          }
        }
      }
    }
  }
}
