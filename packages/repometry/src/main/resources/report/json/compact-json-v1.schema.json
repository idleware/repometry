{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:compact-json:1",
  "type": "object",
  "required": ["schema", "strings", "shapes", "data"],
  "properties": {
    "schema": { "const": "urn:repometry:schema:compact-json:1" },
    "summary": { "$ref": "urn:repometry:schema:repository-summary:1#/$defs/commit" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "shapes": { "type": "array", "items": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
    "data": { "$ref": "#/$defs/node" }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "anyOf": [
        { "type": "null" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
      ]
    }
  }
}
