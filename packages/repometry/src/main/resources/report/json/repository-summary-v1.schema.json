{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:repository-summary:1",
  "type": "object",
  "required": [
    "schema",
    "commits"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:repometry:schema:repository-summary:1"
    },
    "commits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commit"
      }
    },
    "metrics": { "$ref": "urn:repometry:schema:metric-catalog:1" },
    "privateMetrics": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "source": {
      "type": "object",
      "properties": { "branch": { "type": "string" } },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": ["provider", "url"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "web": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "pullReviewCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "nullableCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "quality": {
      "type": "object",
      "required": [
        "codeLines",
        "comments",
        "classes",
        "cognitiveComplexity",
        "duplication",
        "maintainability"
      ],
      "properties": {
        "codeLines": {
          "$ref": "#/$defs/nullableCount"
        },
        "comments": {
          "$ref": "#/$defs/nullableCount"
        },
        "classes": {
          "$ref": "#/$defs/nullableCount"
        },
        "cognitiveComplexity": {
          "$ref": "#/$defs/nullableCount"
        },
        "duplication": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "duplicatedLines",
            "codeLines",
            "ratio"
          ],
          "properties": {
            "duplicatedLines": {
              "type": "integer",
              "minimum": 0
            },
            "codeLines": {
              "type": "integer",
              "minimum": 0
            },
            "ratio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "maintainability": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "smells",
            "effortMinutes",
            "debtRatio",
            "grade"
          ],
          "properties": {
            "smells": {
              "type": "integer",
              "minimum": 0
            },
            "effortMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "debtRatio": {
              "$ref": "#/$defs/ratio"
            },
            "gradeCoverage": {
              "type": "object",
              "required": ["measuredFiles", "totalFiles"],
              "properties": {
                "measuredFiles": { "type": "integer", "minimum": 0 },
                "totalFiles": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            },
            "grade": {
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "F",
                null
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "required": [
        "sha",
        "generatedAt",
        "status",
        "files",
        "parsed",
        "lines",
        "functions",
        "maxComplexity",
        "lineCoverage",
        "quality"
      ],
      "properties": {
        "metrics": { "$ref": "urn:repometry:schema:metric-catalog:1" },
        "privateMetrics": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "values": {
          "type": "object",
          "propertyNames": { "pattern": "^(?:0|[1-9][0-9]*)$" },
          "additionalProperties": { "type": ["number", "null"] }
        },
        "sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "generatedAt": {
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "not-applicable"
          ]
        },
        "files": {
          "$ref": "#/$defs/count"
        },
        "parsed": {
          "$ref": "#/$defs/count"
        },
        "lines": {
          "$ref": "#/$defs/nullableCount"
        },
        "functions": {
          "$ref": "#/$defs/nullableCount"
        },
        "maxComplexity": {
          "$ref": "#/$defs/nullableCount"
        },
        "lineCoverage": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "covered",
            "total"
          ],
          "properties": {
            "covered": {
              "$ref": "#/$defs/count"
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "committedAt": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profileBoundary": {
          "enum": ["changed", "unavailable"]
        },
        "detail": {
          "type": "string",
          "pattern": "^(details|inspection)/(?:[a-f0-9]{40}|[a-f0-9]{64})-[a-f0-9]{64}\\.json$"
        },
        "counts": {
          "type": "object",
          "required": [
            "findingCount",
            "diagnosticCount",
            "componentCount",
            "hasCoverage"
          ],
          "additionalProperties": false,
          "properties": {
            "findingCount": {
              "type": "integer",
              "minimum": 0
            },
            "diagnosticCount": {
              "type": "integer",
              "minimum": 0
            },
            "componentCount": {
              "type": "integer",
              "minimum": 0
            },
            "hasCoverage": {
              "type": "boolean"
            },
            "security": {
              "type": "object",
              "required": [
                "low",
                "medium",
                "high",
                "unknown"
              ],
              "additionalProperties": false,
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 0
                },
                "medium": {
                  "type": "integer",
                  "minimum": 0
                },
                "high": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
