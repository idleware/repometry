{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:pull-review:2",
  "type": "object",
  "required": ["schema", "number", "generatedAt", "base", "mergeBase", "head", "changedFiles", "verdict", "issues", "debt", "coverage", "issueGate", "unmeasured", "notes"],
  "properties": {
    "schema": { "const": "urn:repometry:schema:pull-review:2" },
    "number": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
    "generatedAt": { "type": "string" },
    "base": { "type": "string", "minLength": 1 },
    "mergeBase": { "$ref": "urn:repometry:schema:diff-coverage:1#/$defs/sha" },
    "head": { "$ref": "urn:repometry:schema:diff-coverage:1#/$defs/sha" },
    "changedFiles": { "$ref": "urn:repometry:schema:report:2#/$defs/count" },
    "verdict": { "enum": ["passed", "failed", "unmeasured"] },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "debt": {
      "type": "object",
      "required": ["added", "removed"],
      "properties": {
        "added": { "$ref": "urn:repometry:schema:report:2#/$defs/count" },
        "removed": { "$ref": "urn:repometry:schema:report:2#/$defs/count" }
      },
      "additionalProperties": false
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "issueGate": {
      "type": "object",
      "required": ["maximum", "count", "status"],
      "properties": {
        "maximum": { "$ref": "urn:repometry:schema:report:2#/$defs/count" },
        "count": { "$ref": "urn:repometry:schema:report:2#/$defs/count" },
        "status": { "enum": ["passed", "failed"] }
      },
      "additionalProperties": false
    },
    "unmeasured": { "type": "array", "items": { "$ref": "#/$defs/reason" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/reason" } }
  },
  "additionalProperties": false,
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["effect", "finding", "before", "fixed", "context", "debtMinutes"],
      "properties": {
        "effect": { "enum": ["new", "worsened", "improved", "touched"] },
        "finding": { "$ref": "urn:repometry:schema:report:2#/$defs/finding" },
        "before": { "type": ["number", "null"], "minimum": 0 },
        "fixed": { "type": "boolean" },
        "context": { "$ref": "urn:repometry:schema:report:2#/$defs/finding/properties/related" },
        "debtMinutes": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["imported", "covered", "total", "percent", "uncovered", "unmapped", "gate"],
      "properties": {
        "imported": { "type": "boolean" },
        "covered": { "$ref": "urn:repometry:schema:report:2#/$defs/count" },
        "total": { "$ref": "urn:repometry:schema:report:2#/$defs/count" },
        "percent": { "$ref": "urn:repometry:schema:diff-coverage:1#/properties/percent" },
        "uncovered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "first", "last"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "first": { "type": "integer", "minimum": 1 },
              "last": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "unmapped": { "$ref": "urn:repometry:schema:diff-coverage:1#/properties/gaps" },
        "gate": {
          "type": ["object", "null"],
          "required": ["minimumPercent", "minimumLines", "status"],
          "properties": {
            "minimumPercent": { "$ref": "urn:repometry:schema:diff-coverage:1#/$defs/percent" },
            "minimumLines": { "$ref": "urn:repometry:schema:report:2#/$defs/count" },
            "status": { "enum": ["passed", "failed", "not-applicable"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "path": { "type": "string" },
        "operation": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
