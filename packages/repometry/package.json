{
  "name": "repometry",
  "version": "0.12.1",
  "description": "Track repository metrics without SaaS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idleware/repometry.git"
  },
  "homepage": "https://github.com/idleware/repometry#readme",
  "bugs": {
    "url": "https://github.com/idleware/repometry/issues"
  },
  "keywords": [
    "repository",
    "metrics",
    "coverage",
    "maintainability",
    "static-analysis"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "repometry": "target/main/ts/cli/main.js"
  },
  "files": [
    "target/main",
    "!target/main/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('target/main', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"const fs = require('node:fs'); fs.chmodSync('target/main/ts/cli/main.js', 0o755); fs.mkdirSync('target/main/resources/report/json', { recursive: true }); fs.copyFileSync('../cli/src/main/resources/report/json/config-v2.schema.json', 'target/main/resources/report/json/config-v2.schema.json'); for (const file of ['README.md', 'LICENSE']) fs.cpSync('../../' + file, file)\"",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./target/main/ts/index.d.ts",
      "default": "./target/main/ts/index.js"
    },
    "./plugin": {
      "types": "./target/main/ts/plugin.d.ts",
      "default": "./target/main/ts/plugin.js"
    },
    "./report": {
      "types": "./target/main/ts/report.d.ts",
      "default": "./target/main/ts/report.js"
    }
  },
  "dependencies": {
    "@repometry/cli": "0.0.0",
    "@repometry/language-go": "0.1.0",
    "@repometry/language-python": "0.1.0",
    "@repometry/language-java": "0.0.0",
    "@repometry/language-php": "0.0.0"
  }
}
