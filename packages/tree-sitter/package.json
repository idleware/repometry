{
  "name": "@repometry/tree-sitter",
  "version": "0.1.0",
  "description": "The tree-sitter language plugin engine for Repometry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idleware/repometry.git"
  },
  "homepage": "https://github.com/idleware/repometry#readme",
  "bugs": {
    "url": "https://github.com/idleware/repometry/issues"
  },
  "keywords": [
    "repometry",
    "tree-sitter",
    "plugin"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./target/main/ts/index.d.ts",
      "default": "./target/main/ts/index.js"
    }
  },
  "files": [
    "target/main",
    "!target/main/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('target/main', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('../../LICENSE', 'LICENSE')\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@repometry/core": "0.1.0",
    "web-tree-sitter": "0.27.2"
  }
}
