{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "rootDir": "${configDir}/src/main",
    "outDir": "${configDir}/target/main",
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["${configDir}/src/main/ts/**/*.ts"]
}
