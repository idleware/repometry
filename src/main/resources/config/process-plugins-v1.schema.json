{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:process-plugins:1",
  "title": "Repometry process plugins",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "version", "image", "command", "scope", "tools", "providesLanguages"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "version": { "$ref": "#/$defs/text" },
      "image": {
        "type": "string",
        "pattern": "^(?:[a-z0-9][a-z0-9.:/_-]*@)?sha256:[a-f0-9]{64}$",
        "description": "The full ID or distribution digest of a locally available Docker image."
      },
      "command": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^[^\\u0000]*$" }
      },
      "scope": { "enum": ["file", "repository"] },
      "fileIndependent": {
        "type": "boolean",
        "description": "Each file's results and diagnostics are independent of the other files supplied to a repository parser."
      },
      "claims": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extensions": { "$ref": "#/$defs/extensions" },
          "globs": { "$ref": "#/$defs/globs" }
        }
      },
      "limits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "maxOutputBytes": { "$ref": "#/$defs/positiveInteger" },
          "memoryBytes": { "$ref": "#/$defs/positiveInteger" },
          "pidsLimit": { "$ref": "#/$defs/positiveInteger" }
        }
      },
      "tools": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/text" } },
      "settings": true,
      "providesLanguages": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "$ref": "#/$defs/text" },
            "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "extensions": { "$ref": "#/$defs/extensions" },
            "globs": { "$ref": "#/$defs/globs" },
            "syntax": { "$ref": "#/$defs/syntax" },
            "measures": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["functions", "cyclomaticComplexity", "cognitiveComplexity", "classes",
                "commentLines", "codeLines", "duplication", "structuralRules"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineComments": { "type": "array", "items": { "$ref": "#/$defs/syntax/$defs/marker" } },
        "blockComments": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "$ref": "#/$defs/syntax/$defs/marker" } } },
        "strings": { "type": "array", "items": {
          "type": "object", "required": ["quote"], "additionalProperties": false,
          "properties": { "quote": { "$ref": "#/$defs/syntax/$defs/marker" },
            "multiline": { "type": "boolean" }, "raw": { "type": "boolean" } }
        } },
        "stringPrefixes": { "type": "array", "items": { "$ref": "#/$defs/syntax/$defs/word" } },
        "keywords": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/syntax/$defs/word" } },
        "regexAfter": { "type": "array", "items": { "$ref": "#/$defs/syntax/$defs/word" } }
      },
      "$defs": {
        "marker": { "type": "string", "minLength": 1, "maxLength": 8, "pattern": "^\\S+$" },
        "word": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "extensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[\\w-]+$" } },
    "globs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  }
}
