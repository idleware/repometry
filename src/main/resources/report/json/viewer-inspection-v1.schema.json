{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:viewer-inspection:1",
  "type": "object",
  "required": [
    "schema",
    "sha",
    "inspection"
  ],
  "properties": {
    "schema": {
      "const": "urn:repometry:schema:viewer-inspection:1"
    },
    "sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "context": {
      "$ref": "#/$defs/inspectionContext"
    },
    "inspection": {
      "$ref": "#/$defs/inspection"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "inspection": {
      "type": "object",
      "required": [
        "metrics",
        "functions",
        "diagnostics"
      ],
      "properties": {
        "metrics": {
          "$ref": "urn:repometry:schema:file-metrics:1"
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function"
          }
        },
        "diagnostics": {
          "$ref": "urn:repometry:schema:report:2#/properties/diagnostics"
        },
        "findings": {
          "$ref": "urn:repometry:schema:report:2#/properties/findings"
        },
        "lineCoverage": {
          "$ref": "urn:repometry:schema:report:2#/$defs/lcovLines"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "component",
              "paths"
            ],
            "additionalProperties": false,
            "properties": {
              "component": {
                "type": "object",
                "required": [
                  "name",
                  "pathGlobs"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string"
                  },
                  "pathGlobs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "bands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "complexity": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "missedLines": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "duplication": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "excludedPaths",
        "excludedDirectories",
        "rules",
        "duplication",
        "debtModel",
        "churn",
        "ignore",
        "analyzers"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plugin", "id", "label", "extensions", "globs"],
            "properties": {
              "plugin": { "type": "string" },
              "id": { "type": "string" },
              "label": { "type": "string" },
              "extensions": { "type": "array", "items": { "type": "string" } },
              "globs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ruleCatalog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "kind",
              "rule",
              "category"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "check",
                  "scanner"
                ]
              },
              "rule": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "limit": {
                "type": "number"
              },
              "minutesPerExcess": {
                "type": "number"
              },
              "level": {
                "type": "string"
              },
              "help": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plugin",
              "rule",
              "limit",
              "minutesPerExcess"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "limit": {
                "type": "number"
              },
              "minutesPerExcess": {
                "type": "number"
              },
              "plugin": {
                "type": "string"
              }
            }
          }
        },
        "duplication": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minCodeLines",
                "minNodes",
                "minutesPerRepeatedLine"
              ],
              "properties": {
                "minCodeLines": {
                  "type": "number"
                },
                "minNodes": {
                  "type": "number"
                },
                "minutesPerRepeatedLine": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "debtModel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "scale",
                "exponent",
                "minutesPerPersonMonth"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "scale": {
                  "type": "number"
                },
                "exponent": {
                  "type": "number"
                },
                "minutesPerPersonMonth": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "churn": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lookbackDays",
                "maxCommits"
              ],
              "properties": {
                "lookbackDays": {
                  "type": "number"
                },
                "maxCommits": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "analyzers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "tools"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "tools": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "function": {
      "type": "object",
      "required": [
        "name",
        "path",
        "line",
        "complexity"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "complexity": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "inspectionContext": {
      "type": "object",
      "required": [
        "exclusions",
        "boundary"
      ],
      "properties": {
        "exclusions": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "paths",
            "directories"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "directories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "boundary": {
          "enum": [
            null,
            "changed",
            "unavailable"
          ]
        },
        "scanners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "ignores": {
          "type": "object",
          "required": [
            "rules",
            "count"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string"
                  },
                  "rule": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "security": {
          "type": "object",
          "required": [
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "properties": {
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
