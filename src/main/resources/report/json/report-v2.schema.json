{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:report:2",
  "type": "object",
  "required": [
    "schema",
    "subject",
    "generatedAt",
    "appliedConfig",
    "definitions",
    "scope",
    "status",
    "measurements",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "urn:repometry:schema:report:2"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "generatedAt": {
      "type": "string"
    },
    "committedAt": {
      "type": "string"
    },
    "commit": {
      "type": "object",
      "required": ["subject", "author"],
      "properties": {
        "subject": { "type": "string" },
        "author": {
          "type": "object",
          "required": ["name", "email"],
          "properties": { "name": { "type": "string" }, "email": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "appliedConfig": {
      "type": "object",
      "minProperties": 1
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "files",
        "parsed"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/count"
        },
        "parsed": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "not-applicable"
      ]
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "ruleSkips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "plugin", "rules", "reason"],
        "properties": {
          "path": { "type": "string" },
          "plugin": { "type": "string" },
          "rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "reason": { "const": "unmeasured" }
        },
        "additionalProperties": false
      }
    },
    "pluginData": {
      "type": "object",
      "required": ["metrics", "measured", "rules", "products"],
      "properties": {
        "metrics": { "$ref": "urn:repometry:schema:metric-catalog:1" },
        "measured": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "privateMetrics": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["plugin", "rules"],
            "properties": {
              "plugin": { "type": "string" },
              "rules": { "type": "array", "items": { "$ref": "#/$defs/pluginRule" } }
            },
            "additionalProperties": false
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" }
            },
            "additionalProperties": false
          }
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "lines", "language", "analysed"],
            "properties": {
              "path": { "type": "string" },
              "lines": { "type": ["integer", "null"], "minimum": 0 },
              "bytes": { "type": "integer", "minimum": 0 },
              "language": { "type": "string" },
              "provider": { "type": "string", "minLength": 1 },
              "analysed": { "type": "boolean" },
              "unmeasured": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["functions", "cyclomaticComplexity", "cognitiveComplexity", "classes",
                  "commentLines", "codeLines", "duplication", "structuralRules"] }
              }
            },
            "additionalProperties": false
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": { "anyOf": [{ "type": "object" }, { "type": "boolean" }] }
        },
        "products": {
          "type": "object",
          "properties": {
            "repometry.lcov-lines/v1": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/reportProduct",
                "type": "object",
                "properties": { "value": { "$ref": "#/$defs/lcovLines" } }
              }
            }
          },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/reportProduct" }
          }
        }
      },
      "additionalProperties": false
    },
    "ignoredFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "matchedRule"],
        "properties": {
          "finding": { "$ref": "#/$defs/finding" },
          "matchedRule": { "$ref": "#/$defs/count" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "measurement": {
      "type": "object",
      "required": [
        "definition",
        "target",
        "value"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "repository",
            "file",
            "function"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "covered": {
          "$ref": "#/$defs/count"
        },
        "total": {
          "$ref": "#/$defs/count"
        }
      },
      "dependentRequired": {
        "covered": [
          "total"
        ],
        "total": [
          "covered"
        ],
        "line": [
          "path"
        ],
        "column": [
          "line"
        ]
      },
      "if": {
        "properties": {
          "target": {
            "enum": [
              "file",
              "function"
            ]
          }
        }
      },
      "then": {
        "required": [
          "path"
        ]
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "operation",
        "state",
        "message"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "state": {
          "enum": [
            "failed",
            "blocked",
            "partial"
          ]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reportProduct": {
      "type": "object",
      "required": ["operation", "value"],
      "properties": { "operation": { "type": "string" }, "path": { "type": "string" }, "value": true },
      "additionalProperties": false
    },
    "lcovLines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["covered", "uncovered"],
        "additionalProperties": false,
        "properties": {
          "covered": { "$ref": "#/$defs/lcovLineRanges" },
          "uncovered": { "$ref": "#/$defs/lcovLineRanges" },
          "partial": { "$ref": "#/$defs/lcovLineRanges" },
          "hits": { "$ref": "#/$defs/lcovHitRuns" },
          "functionCalls": { "$ref": "#/$defs/lcovFunctionCalls" },
          "functionBodies": { "$ref": "#/$defs/lcovLineRanges" }
        }
      }
    },
    "lcovLineRanges": {
      "type": "array",
      "description": "Sorted, merged 1-based inclusive line ranges.",
      "items": {
        "type": "array",
        "minItems": 2,
        "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
        "items": false
      }
    },
    "lcovHitRuns": {
      "type": "array",
      "description": "Ordered inclusive ranges of measured lines with the same hit count.",
      "items": {
        "type": "array",
        "minItems": 3,
        "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 0 }],
        "items": false
      }
    },
    "lcovFunctionCalls": {
      "type": "array",
      "description": "Pairs of 1-based function declaration line and summed LCOV call count, ordered by line. Multiple functions can share a line.",
      "items": {
        "type": "array",
        "minItems": 2,
        "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 0 }],
        "items": false
      }
    },
    "pluginRule": {
      "type": "object",
      "required": ["id", "category"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "defaults": {
          "type": "object",
          "properties": { "limit": { "type": "number" }, "cost": { "type": "number" } },
          "additionalProperties": false
        },
        "measure": { "type": "string" },
        "per": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "tool",
        "rule",
        "category",
        "level",
        "message"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "structure",
            "duplication",
            "lint",
            "security",
            "dependency",
            "secret",
            "infrastructure"
          ]
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "effortMinutes": {
          "$ref": "#/$defs/count"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "line",
              "endLine"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "dependentRequired": {
        "line": [
          "path"
        ],
        "endLine": [
          "line"
        ]
      },
      "additionalProperties": false
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "commit",
            "working-tree"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "const": "commit"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          }
        }
      },
      "else": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
