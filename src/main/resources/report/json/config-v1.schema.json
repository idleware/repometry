{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:config:1",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "exclude": { "$ref": "#/$defs/strings" },
    "ignore": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "anyOf": [{ "required": ["tool"] }, { "required": ["rule"] }, { "required": ["path"] }],
        "additionalProperties": false
      }
    },
    "imports": { "$ref": "#/$defs/strings" },
    "reports": { "$ref": "#/$defs/strings" },
    "sources": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pathGlobs"],
        "properties": {
          "name": { "type": "string", "maxLength": 100, "pattern": "\\S" },
          "pathGlobs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000]+/)*(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            }
          },
          "description": { "type": "string" }
        }
      }
    },
    "minCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
    "minLines": { "type": "integer", "minimum": 0 },
    "maxNewIssues": { "type": "integer", "minimum": 0 },
    "plugins": { "$ref": "urn:repometry:schema:process-plugins:1" }
  },
  "additionalProperties": false,
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "processPlugins": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:repometry:schema:process-plugins:1",
      "title": "Repometry process plugins",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "image", "command", "scope", "tools", "providesLanguages"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "version": { "$ref": "#/$defs/text" },
          "image": {
            "type": "string",
            "pattern": "^(?:[a-z0-9][a-z0-9.:/_-]*@)?sha256:[a-f0-9]{64}$",
            "description": "The full ID or distribution digest of a locally available Docker image."
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[^\\u0000]*$" }
          },
          "scope": { "enum": ["file", "repository"] },
          "fileIndependent": {
            "type": "boolean",
            "description": "Each file's results and diagnostics are independent of the other files supplied to a repository parser."
          },
          "claims": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extensions": { "$ref": "#/$defs/extensions" },
              "globs": { "$ref": "#/$defs/globs" }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
              "maxOutputBytes": { "$ref": "#/$defs/positiveInteger" },
              "memoryBytes": { "$ref": "#/$defs/positiveInteger" },
              "pidsLimit": { "$ref": "#/$defs/positiveInteger" }
            }
          },
          "tools": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/text" } },
          "settings": true,
          "providesLanguages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "label": { "$ref": "#/$defs/text" },
                "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "extensions": { "$ref": "#/$defs/extensions" },
                "globs": { "$ref": "#/$defs/globs" },
                "measures": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["functions", "cyclomaticComplexity", "cognitiveComplexity", "classes",
                    "commentLines", "codeLines", "duplication", "structuralRules"] }
                }
              }
            }
          }
        }
      },
      "$defs": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "text": { "type": "string", "pattern": "\\S" },
        "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "extensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[\\w-]+$" } },
        "globs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
