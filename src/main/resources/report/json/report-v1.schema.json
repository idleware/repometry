{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:report:1",
  "type": "object",
  "required": ["schema", "subject", "generatedAt", "appliedConfig", "definitions", "scope", "status", "measurements", "diagnostics"],
  "properties": {
    "schema": { "const": "urn:repometry:schema:report:1" },
    "subject": { "$ref": "#/$defs/subject" },
    "generatedAt": { "type": "string" },
    "appliedConfig": { "type": "object", "minProperties": 1 },
    "definitions": { "type": "object", "additionalProperties": { "type": "string" } },
    "scope": {
      "type": "object",
      "required": ["files", "parsed"],
      "properties": { "files": { "$ref": "#/$defs/count" }, "parsed": { "$ref": "#/$defs/count" } },
      "additionalProperties": false
    },
    "status": { "enum": ["complete", "partial", "not-applicable"] },
    "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "additionalProperties": false,
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": { "kind": { "enum": ["commit", "working-tree"] }, "id": { "type": "string" } },
      "additionalProperties": false,
      "if": { "properties": { "kind": { "const": "commit" } } },
      "then": { "properties": { "id": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" } } },
      "else": { "properties": { "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
    },
    "measurement": {
      "type": "object",
      "required": ["definition", "target", "value"],
      "properties": {
        "definition": { "type": "string", "minLength": 1 },
        "target": { "enum": ["repository", "file", "function"] },
        "value": { "type": ["number", "null"] },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "covered": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" }
      },
      "dependentRequired": { "covered": ["total"], "total": ["covered"], "line": ["path"], "column": ["line"] },
      "if": { "properties": { "target": { "enum": ["file", "function"] } } },
      "then": { "required": ["path"] },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["operation", "state", "message"],
      "properties": {
        "operation": { "type": "string" },
        "state": { "enum": ["failed", "blocked", "partial"] },
        "path": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
