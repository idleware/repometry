{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repometry:schema:viewer-details:1",
  "type": "object",
  "required": [
    "schema",
    "context",
    "inspections"
  ],
  "properties": {
    "schema": {
      "const": "urn:repometry:schema:viewer-details:1"
    },
    "context": {
      "$ref": "urn:repometry:schema:inspection-context:1"
    },
    "inspections": {
      "type": "object",
      "patternProperties": {
        "^(?:[a-f0-9]{40}|[a-f0-9]{64})$": {
          "$ref": "#/$defs/inspection"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "inspection": {
      "type": "object",
      "required": [
        "metrics",
        "functions",
        "diagnostics"
      ],
      "properties": {
        "metrics": {
          "$ref": "urn:repometry:schema:file-metrics:1"
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "urn:repometry:schema:inspection-context:1#/$defs/complexFunctions/items"
          }
        },
        "diagnostics": {
          "$ref": "urn:repometry:schema:report:1#/properties/diagnostics"
        },
        "findings": {
          "$ref": "urn:repometry:schema:report:2#/properties/findings"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "component",
              "paths"
            ],
            "additionalProperties": false,
            "properties": {
              "component": {
                "type": "object",
                "required": [
                  "name",
                  "pathGlobs"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string"
                  },
                  "pathGlobs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "bands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "complexity": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "missedLines": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "duplication": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "extensions",
        "excludedPaths",
        "excludedDirectories",
        "rules",
        "duplication",
        "debtModel",
        "churn",
        "ignore",
        "analyzers"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ruleCatalog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "kind", "rule", "category"],
            "properties": {
              "source": { "type": "string" },
              "kind": { "enum": ["check", "scanner"] },
              "rule": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "limit": { "type": "number" },
              "minutesPerExcess": { "type": "number" },
              "level": { "type": "string" },
              "help": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plugin",
              "rule",
              "limit",
              "minutesPerExcess"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "limit": {
                "type": "number"
              },
              "minutesPerExcess": {
                "type": "number"
              },
              "plugin": {
                "type": "string"
              }
            }
          }
        },
        "duplication": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minCodeLines",
                "minNodes",
                "minutesPerRepeatedLine"
              ],
              "properties": {
                "minCodeLines": {
                  "type": "number"
                },
                "minNodes": {
                  "type": "number"
                },
                "minutesPerRepeatedLine": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "debtModel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "scale",
                "exponent",
                "minutesPerPersonMonth"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "scale": {
                  "type": "number"
                },
                "exponent": {
                  "type": "number"
                },
                "minutesPerPersonMonth": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "churn": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lookbackDays",
                "maxCommits"
              ],
              "properties": {
                "lookbackDays": {
                  "type": "number"
                },
                "maxCommits": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "analyzers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "tools"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "tools": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
